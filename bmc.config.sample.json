{
  "detection": {
    "vpnAdapterPattern": "F5|BIG-IP",
    "officeDnsSuffixPattern": "(^|\\.)bndes\\.net\\:8180$"
  },
  "scenarios": {
    "Office": {
      "proxy": "auto",
      "nexus": true
    },
    "Vpn": {
      "proxy": "auto",
      "nexus": true
    },
    "Home": {
      "proxy": "none",
      "nexus": false
    }
  },
  "proxy": {
    "overrideUrl": "http://127.0.0.1:3128",
    "noProxy": "localhost,127.0.0.1,.corp.example.com",
    "probeUrl": "https://pypi.org"
  },
  "nexus": {
    "pypiIndexUrl": "http://nexus.bndes.net:8180/nexus/repository/pypi-proxy/simple",
    "npmRegistryUrl": "http://nexus.bndes.net:8180/nexus/repository/npm-group/"
  },
  "git": {
    "useCurrentUserCredentials": true
  },
  "tools": [
    "Git",
    "Scoop",
    "Uv",
    "Npm",
    "Environment"
  ]
}